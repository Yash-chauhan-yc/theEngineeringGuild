# ─── Site ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://theengineeringguild.com

# Public contact details shown on the site (edit to your real ones)
NEXT_PUBLIC_CONTACT_EMAIL=enquiries@theengineeringguild.com
NEXT_PUBLIC_CONTACT_PHONE=+91 90000 00000
# Digits only, with country code, no + or spaces — used for the floating WhatsApp chat button
NEXT_PUBLIC_WHATSAPP_NUMBER=919000000000

# ─── Feature 1: Your real email ───────────────────────────────────────
# Every enquiry is delivered here (comma-separate for several inboxes)
ENQUIRY_TO_EMAIL=you@yourbusiness.com
# The "From" address. Must be a mailbox/domain your SMTP provider lets you send from.
ENQUIRY_FROM_EMAIL="The Engineering Guild <no-reply@theengineeringguild.com>"
# Send the customer an automatic acknowledgement with their ticket number (true/false)
SEND_CUSTOMER_ACK=true

# SMTP — works with Google Workspace, Zoho, Microsoft 365, Amazon SES, Brevo, Resend SMTP, etc.
# Gmail/Workspace: host smtp.gmail.com, port 465, secure true, use an App Password.
# Zoho: smtp.zoho.in, 465, true.   Resend: smtp.resend.com, 465, true, user "resend", pass = API key.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@yourbusiness.com
SMTP_PASS=your-app-password

# ─── Feature 4: WhatsApp alerts ───────────────────────────────────────
# Which enquiries trigger a WhatsApp ping: "emergency" (default) or "all"
WHATSAPP_ALERT_ON=emergency
# Your phone number that receives the alert (digits with country code)
WHATSAPP_ALERT_TO=919000000000

# Option A — Meta WhatsApp Cloud API (recommended, free tier available)
#   Create an app at developers.facebook.com → WhatsApp → get a Phone Number ID and a permanent token.
#   Approve a template (see README) named below with 4 body variables.
WHATSAPP_PROVIDER=meta
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_TEMPLATE=emergency_enquiry
META_WA_TEMPLATE_LANG=en

# Option B — Twilio WhatsApp (set WHATSAPP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# e.g. whatsapp:+14155238886 (sandbox) or your approved sender
TWILIO_WHATSAPP_FROM=

# ─── Optional: forward every enquiry to a webhook (Google Sheets via Apps Script, Zapier, Make, a CRM…)
ENQUIRY_WEBHOOK_URL=
